# 1. ดึงแผ่นฐาน (Image) ของ Node.js เวอร์ชันเสถียรมาใช้งาน
FROM node:20-alpine

# 2. ตั้งโฟลเดอร์หลักในระบบจำลองเพื่อทำงาน
WORKDIR /app

# 3. ก๊อปปี้ไฟล์เช็คแพ็กเกจเข้าไปก่อนเพื่อทำการติดตั้งระบบ
COPY package*.json ./

# 4. สั่งติดตั้ง Library ที่โปรเจกต์ต้องใช้
RUN npm install

# 5. ก๊อปปี้ซอร์สโค้ดที่เหลือทั้งหมดในโฟลเดอร์ backend เข้าไปในระบบจำลอง
COPY . .

# 6. บอกให้โลกรู้ว่าโปรเจกต์ backend ของมึงจะเปิดใช้งานที่ Port ไหน (สมมติว่า Port 5000)
EXPOSE 5000

# 7. คำสั่งสุดท้ายสำหรับสั่งให้โปรเจกต์ของมึงสตาร์ททำงาน
CMD ["npm", "start"]